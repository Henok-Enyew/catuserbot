# CatUserBot environment variables
# Copy this to .env and fill in your values. Do not commit .env (it is gitignored).
# For Docker:  docker run --env-file .env ...
# For Render:  set these in Dashboard -> Environment.

# Required: use env-based config (sample_config)
ENV=True

# Identity & Telegram
ALIVE_NAME=Meow
APP_ID=1227348
API_HASH=your_api_hash
STRING_SESSION=your_string_session
OWNER_ID=1035034432

# Bot
TG_BOT_TOKEN=your_bot_token
PRIVATE_GROUP_BOT_API_ID=-1002195536146
PM_LOGGER_GROUP_ID=-4233484248

# Database (use Pooler URL with port 6543 on Render)
DATABASE_URL=postgresql://user:password@host.pooler.supabase.com:6543/postgres

# Commands & repo
COMMAND_HAND_LER=.
SUDO_COMMAND_HAND_LER=.
EXTERNAL_REPO=https://github.com/TgCatUB/CatPlugins
BADCAT=False

# Optional: Gemini AI for .gem / .gpt commands (get key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Kuki API for .addai auto-replies (get key from kukiapi.xyz)
KUKI_API_KEY=your_kuki_api_key_here

# Optional: uptime ping (e.g. Render)
UPTIME_PING_URL=https://your-app.onrender.com
COUNTRY=Ethiopia
TZ_NUMBER=3
